[Unit]
Description=Back up Music Atlas identity database

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/music-atlas-current
ExecStart=/usr/bin/python3 /home/ubuntu/apps/music-atlas-current/tools/backup_auth_db.py --keep-days 14
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/apps/music-atlas/runtime
